{
  "lexicon": 1,
  "id": "com.internet4000.partiii.post",
  "defs": {
    "main": {
      "type": "record",
      "description": "A short public contribution to a Partiii conversation.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "text",
          "createdAt"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "maxGraphemes": 1000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "place": {
            "type": "object",
            "description": "An optional approximate place related to the contribution, never the author's home location.",
            "required": [
              "latitude",
              "longitude"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "latitude": {
                "type": "integer",
                "minimum": -90000000,
                "maximum": 90000000,
                "description": "Degrees multiplied by 1,000,000; rounded to 0.25 degrees before writing."
              },
              "longitude": {
                "type": "integer",
                "minimum": -180000000,
                "maximum": 180000000,
                "description": "Degrees multiplied by 1,000,000; rounded to 0.25 degrees before writing."
              }
            }
          }
        }
      }
    }
  }
}
